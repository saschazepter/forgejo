<h4 class="ui top attached header">
	{{ctx.Locale.Tr "settings.sessions"}}
</h4>
<div class="ui attached segment">
	<p>{{ctx.Locale.Tr "settings.sessions_desc"}}</p>
	<button class="ui red button delete-button" data-modal-id="sign-out-sessions" data-url="{{AppSubUrl}}/user/settings/security/sessions/sign_out">
		{{ctx.Locale.Tr "settings.sessions_sign_out"}}
	</button>

	<div class="ui g-modal-confirm delete modal" id="sign-out-sessions">
		<div class="header">
			{{svg "octicon-trash"}}
			{{ctx.Locale.Tr "settings.sessions_sign_out"}}
		</div>
		<div class="content">
			<p>{{ctx.Locale.Tr "settings.sessions_sign_out_desc"}}</p>
		</div>
		{{template "base/modal_actions_confirm" .}}
	</div>
</div>
